---
import MemberLayout from "../layouts/MemberLayout.astro";
import { env } from "cloudflare:workers";
import { loadCatalog } from "../catalog/load-catalog";
import { flattenCatalog, groupSlotsByTaipeiDate } from "../catalog/group-slots-by-date";
import { slotAvailability } from "../catalog/slot-status";
import { formatTaipeiTime } from "../catalog/taipei-time";
import { loginUrl } from "../auth/member";
import { handleHoldPost } from "../holds/submit";
import { cancellationRuleText } from "../holds/cancel-rule";

export const prerender = false;

const member = Astro.locals.member;
let holdError = "";

if (Astro.request.method === "POST") {
  const outcome = await handleHoldPost({ member, request: Astro.request, app: env.APP, url: Astro.url });
  if ("redirect" in outcome) return Astro.redirect(outcome.redirect, outcome.status);
  holdError = outcome.error;
  Astro.response.status = outcome.status;
}

const catalog = await loadCatalog(env.APP);
const now = Date.now();

// 各資源的時段攤平後依台北日期分組
const STATUS_LABEL = { started: "已開始／不可預訂", full: "已額滿", open: "尚未開始" } as const;
const dateGroups = groupSlotsByTaipeiDate(flattenCatalog(catalog));
---

<MemberLayout title="時段列表">
  <h1>Holdfast 訂位</h1>
  {holdError && <p role="alert">{holdError}</p>}
  <p>時間皆為台北時間。</p>
  {dateGroups.length === 0 && <p>目前沒有尚未結束的時段。</p>}
  {
    dateGroups.map((group) => (
      <section aria-labelledby={`day-${group.date}`}>
        <h2 id={`day-${group.date}`}>{group.heading}</h2>
        <ul class="card-list">
          {group.slots.map((slot) => {
            // 伺服器把超占的剩餘名額以 0 回傳，不會是負數；這裡只是 UI 提示，是否額滿仍由 App Worker 判定
            const availability = slotAvailability(slot.startsAt, slot.remainingSeats, now);
            return (
              <li>
                <article class="card" aria-labelledby={`slot-${slot.id}-title slot-${slot.id}-time`}>
                  <header class="card-head">
                    <h3 id={`slot-${slot.id}-title`}>{slot.resourceName}</h3>
                    <span class:list={["badge", { "badge--muted": availability !== "open" }]}>
                      {STATUS_LABEL[availability]}
                    </span>
                  </header>
                  <p class="slot-time" id={`slot-${slot.id}-time`}>
                    {formatTaipeiTime(slot.startsAt)}–{formatTaipeiTime(slot.endsAt)}
                  </p>
                  <p class="slot-seats">
                    剩餘名額 {slot.remainingSeats} / {slot.capacity}
                  </p>
                  {availability !== "open" ? null : member ? (
                    <form method="post" class="hold-form">
                      <input type="hidden" name="slotId" value={slot.id} />
                      <input type="hidden" name="idempotencyKey" value={crypto.randomUUID()} />
                      <label>
                        名額
                        <input type="number" name="seats" min="1" max={slot.seatsPerHold} value="1" required />
                      </label>
                      <button type="submit">保留</button>
                    </form>
                  ) : (
                    <a href={loginUrl(Astro.url)}>登入後保留</a>
                  )}
                </article>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }
  {
    catalog.length > 0 && (
      <section aria-labelledby="notes-heading">
        <h2 id="notes-heading">訂位須知</h2>
        <ul>
          {catalog.map(({ resource }) => (
            <li>
              <h3>{resource.name}</h3>
              {resource.description && <p>{resource.description}</p>}
              <p>{cancellationRuleText(resource.cancellationCutoffSeconds)}</p>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</MemberLayout>

<style>
  .slot-time {
    margin: var(--space-2) 0 0;
    font-size: var(--text-lg);
    font-variant-numeric: tabular-nums;
  }
  .slot-seats {
    margin: 0 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }
  .hold-form {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hold-form label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .hold-form input[type="number"] {
    width: 5rem;
  }
</style>
