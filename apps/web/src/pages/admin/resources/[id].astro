---
import { env } from "cloudflare:workers";
import { readAccessJwt } from "../../../admin/access-jwt";
import {
  formToRecord,
  resourceFormToInput,
  slotBatchFormToInput,
  slotCapacityFormToInput,
  slotFormToInput,
  slotIdFormToInput,
  slotTimeFormToInput,
} from "../../../admin/forms";
import { describeFailure, type Failure } from "../../../admin/reasons";
import { formatTaipeiDateTimeInput } from "../../../admin/taipei-input";
import type { SlotTimes } from "../../../admin/slot-batch-view";
import { describeOccupancy } from "../../../admin/slot-occupancy";
import { formatTaipeiDate, formatTaipeiTime } from "../../../catalog/taipei-time";
import AccessDenied from "../../../components/AccessDenied.astro";
import SlotBatchTable from "../../../components/SlotBatchTable.astro";
import ResourceForm from "../../../components/ResourceForm.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";

export const prerender = false;

const jwt = readAccessJwt(Astro.request, env, import.meta.env.DEV);
const resourceId = Number(Astro.params.id);

let resourceFailure: Failure | undefined;
let retirementFailure: Failure | undefined;
let slotFailure: Failure | undefined;
let rowFailure: Failure | undefined;
let batchFailure: Failure | undefined;
let batchPreview: { slots: SlotTimes[]; skipped: SlotTimes[] } | undefined;
let batchResult: { slots: SlotTimes[]; skipped: SlotTimes[] } | undefined;
let submittedWeekdays: string[] = [];
let submitted: Record<string, string> = {};
let notice = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  submitted = formToRecord(form);
  submittedWeekdays = form.getAll("weekdays").map(String);
  const intent = form.get("intent");

  if (intent === "update-resource") {
    const result = await env.APP.updateResource(jwt, resourceFormToInput(form, resourceId));
    if (result.ok) return Astro.redirect(`/admin/resources/${resourceId}?saved=updated`, 303);
    if (result.reason !== "unauthorized") resourceFailure = describeFailure(result);
  } else if (intent === "retire-resource") {
    const result = await env.APP.retireResource(jwt, resourceId);
    if (result.ok) return Astro.redirect(`/admin/resources/${resourceId}?saved=retired`, 303);
    if (result.reason !== "unauthorized") retirementFailure = describeFailure(result);
  } else if (intent === "reactivate-resource") {
    const result = await env.APP.reactivateResource(jwt, resourceId);
    if (result.ok) return Astro.redirect(`/admin/resources/${resourceId}?saved=reactivated`, 303);
    if (result.reason !== "unauthorized") retirementFailure = describeFailure(result);
  } else if (intent === "create-slot") {
    const result = await env.APP.createSlot(jwt, slotFormToInput(form, resourceId));
    if (result.ok) return Astro.redirect(`/admin/resources/${resourceId}?saved=slot`, 303);
    if (result.reason !== "unauthorized") slotFailure = describeFailure(result);
  } else if (intent === "preview-batch") {
    const result = await env.APP.previewSlotBatch(jwt, slotBatchFormToInput(form, resourceId));
    if (result.ok) batchPreview = result.data;
    else if (result.reason !== "unauthorized") batchFailure = describeFailure(result);
  } else if (intent === "create-batch") {
    const result = await env.APP.createSlotBatch(jwt, slotBatchFormToInput(form, resourceId));
    if (result.ok) batchResult = result.data;
    else if (result.reason !== "unauthorized") batchFailure = describeFailure(result);
  } else if (intent === "update-capacity") {
    const result = await env.APP.updateSlotCapacity(jwt, slotCapacityFormToInput(form));
    if (result.ok) return Astro.redirect(`/admin/resources/${resourceId}?saved=capacity`, 303);
    if (result.reason !== "unauthorized") rowFailure = describeFailure(result);
  } else if (intent === "update-time") {
    const result = await env.APP.updateSlotTime(jwt, slotTimeFormToInput(form));
    if (result.ok) return Astro.redirect(`/admin/resources/${resourceId}?saved=time`, 303);
    if (result.reason !== "unauthorized") rowFailure = describeFailure(result);
  } else if (intent === "delete-slot") {
    const result = await env.APP.deleteSlot(jwt, slotIdFormToInput(form));
    if (result.ok) return Astro.redirect(`/admin/resources/${resourceId}?saved=deleted`, 303);
    if (result.reason !== "unauthorized") rowFailure = describeFailure(result);
  }
}

const saved = Astro.url.searchParams.get("saved");
if (saved === "updated") notice = "資源已更新";
if (saved === "retired") notice = "資源已停用；既有保留與訂位仍然有效";
if (saved === "reactivated") notice = "資源已重新啟用";
if (saved === "slot") notice = "時段已建立";
if (saved === "capacity") notice = "容量已更新";
if (saved === "time") notice = "時段時間已更新";
if (saved === "deleted") notice = "時段已刪除";

const found = await env.APP.getResourceForAdmin(jwt, resourceId);
const unauthorized = !found.ok && found.reason === "unauthorized";
const resource = found.ok ? found.data : undefined;
const slots = resource ? await env.APP.listSlotsForAdmin(jwt, resourceId) : undefined;

if (unauthorized) Astro.response.status = 403;
else if (!resource) Astro.response.status = 404;

const resourceValues = resourceFailure && submitted.intent === "update-resource" ? submitted : resource;
const slotValues = slotFailure ? submitted : {};
const rowFailureSlotId = Number(submitted.slotId);
/** 該列送出失敗時回填使用者輸入的值，否則顯示目前的值。 */
const refill = (slotId: number, field: string, current: string | number) =>
  rowFailure && rowFailureSlotId === slotId && submitted.intent === "update-time" ? (submitted[field] ?? "") : current;
const slotErrors = slotFailure?.fields ?? {};
const batchErrors = batchFailure?.fields ?? {};
/** 預覽成功或失敗時都回填使用者輸入；建立成功後清空表單。 */
const batchValues = batchResult ? {} : submitted.intent === "preview-batch" || submitted.intent === "create-batch" ? submitted : {};
const batchWeekdays = batchResult ? [] : submittedWeekdays;
const weekdayOptions = [
  { value: "1", label: "一" },
  { value: "2", label: "二" },
  { value: "3", label: "三" },
  { value: "4", label: "四" },
  { value: "5", label: "五" },
  { value: "6", label: "六" },
  { value: "0", label: "日" },
];
---

<AdminLayout title={resource ? resource.name : "資源"}>
  {
    unauthorized ? (
      <AccessDenied />
    ) : !resource ? (
      <p class="error" role="alert">找不到這個資源。</p>
    ) : (
      <>
        {notice && <p class="notice" role="status">{notice}</p>}
        <h2>修改資源</h2>
        <ResourceForm resourceId={resourceId} values={resourceValues ?? {}} failure={resourceFailure} submitLabel="儲存" />
        <p>修改保留期限只影響之後建立的保留。</p>

        <h2>資源狀態</h2>
        {retirementFailure && <p class="error" role="alert">{retirementFailure.message}</p>}
        {resource.retiredAt === null ? (
          <>
            <p>目前有 {resource.futureBookingCount} 筆未來訂位。停用後這些訂位和既有保留仍然有效，請視需要自行聯絡會員。</p>
            <form method="post">
              <input type="hidden" name="intent" value="retire-resource" />
              <button type="submit">停用資源</button>
            </form>
          </>
        ) : (
          <>
            <p>已停用；既有保留與訂位仍然有效。</p>
            <form method="post">
              <input type="hidden" name="intent" value="reactivate-resource" />
              <button type="submit">重新啟用資源</button>
            </form>
          </>
        )}

        <h2>時段（台北時間）</h2>
        {slots?.ok && slots.data.length === 0 && <p>目前沒有時段。</p>}
        {
          slots?.ok && slots.data.length > 0 && (
            <div class="table-scroll">
              <table>
                <thead><tr><th>日期</th><th>時間</th><th>容量</th><th>已占用</th><th>剩餘</th><th>狀態</th><th>操作</th></tr></thead>
                <tbody>
                  {slots.data.map((s) => (
                    <tr>
                      <td>{formatTaipeiDate(s.startsAt)}</td>
                      <td>{formatTaipeiTime(s.startsAt)}–{formatTaipeiTime(s.endsAt)}</td>
                      <td>{s.capacity}</td>
                      <td>{s.occupied}</td>
                      <td>{s.remainingSeats}</td>
                      <td>{describeOccupancy(s)}</td>
                      <td>
                        <a href={`/admin/slots/${s.id}`}>查看保留與訂位</a>
                        <form method="post">
                          <input type="hidden" name="intent" value="update-capacity" />
                          <input type="hidden" name="slotId" value={s.id} />
                          <input
                            name="capacity"
                            inputmode="numeric"
                            aria-label="新容量"
                            value={rowFailure && rowFailureSlotId === s.id ? (submitted.capacity ?? "") : s.capacity}
                            required
                          />
                          <button type="submit">調整容量</button>
                        </form>
                        <form method="post">
                          <input type="hidden" name="intent" value="update-time" />
                          <input type="hidden" name="slotId" value={s.id} />
                          <input
                            type="datetime-local"
                            name="startsAt"
                            aria-label="新開始（台北時間）"
                            value={refill(s.id, "startsAt", formatTaipeiDateTimeInput(s.startsAt))}
                            required
                          />
                          <input
                            type="datetime-local"
                            name="endsAt"
                            aria-label="新結束（台北時間）"
                            value={refill(s.id, "endsAt", formatTaipeiDateTimeInput(s.endsAt))}
                            required
                          />
                          <button type="submit">修改時間</button>
                        </form>
                        <form method="post">
                          <input type="hidden" name="intent" value="delete-slot" />
                          <input type="hidden" name="slotId" value={s.id} />
                          <button type="submit">刪除</button>
                        </form>
                        {rowFailure && rowFailureSlotId === s.id && (
                          <>
                            <p class="error" role="alert">{rowFailure.message}</p>
                            {rowFailure.fields.capacity?.map((m) => <span class="error">{m}</span>)}
                            {rowFailure.fields.startsAt?.map((m) => <span class="error">{m}</span>)}
                            {rowFailure.fields.endsAt?.map((m) => <span class="error">{m}</span>)}
                          </>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )
        }
        <p>時段仍有保留或訂位紀錄（過期或已釋放的保留除外）時，不能修改時間。</p>
        <p>容量可調到低於已占用：既有的保留與訂位不受影響，但超占的時段不再接受新的保留。</p>
        {resource.retiredAt === null ? (
          <>
            <h3>建立時段</h3>
            <form method="post">
              <input type="hidden" name="intent" value="create-slot" />
              {slotFailure && <p class="error" role="alert">{slotFailure.message}</p>}
              <label>
                開始（台北時間）
                <input type="datetime-local" name="startsAt" value={slotValues.startsAt ?? ""} required />
                {slotErrors.startsAt?.map((m) => <span class="error">{m}</span>)}
              </label>
              <label>
                結束（台北時間）
                <input type="datetime-local" name="endsAt" value={slotValues.endsAt ?? ""} required />
                {slotErrors.endsAt?.map((m) => <span class="error">{m}</span>)}
              </label>
              <label>
                容量
                <input name="capacity" inputmode="numeric" value={slotValues.capacity ?? ""} required />
                {slotErrors.capacity?.map((m) => <span class="error">{m}</span>)}
              </label>
              <p><button type="submit">建立時段</button></p>
            </form>
            <h3>批次建立時段</h3>
            <form method="post">
              <input type="hidden" name="intent" value="preview-batch" />
              {batchFailure && <p class="error" role="alert">{batchFailure.message}</p>}
              <label>
                從（日期）
                <input type="date" name="fromDate" value={batchValues.fromDate ?? ""} required />
                {batchErrors.fromDate?.map((m) => <span class="error">{m}</span>)}
              </label>
              <label>
                到（日期）
                <input type="date" name="toDate" value={batchValues.toDate ?? ""} required />
                {batchErrors.toDate?.map((m) => <span class="error">{m}</span>)}
              </label>
              <fieldset>
                <legend>星期幾</legend>
                {weekdayOptions.map((d) => (
                  <label>
                    <input type="checkbox" name="weekdays" value={d.value} checked={batchWeekdays.includes(d.value)} />
                    {d.label}
                  </label>
                ))}
                {batchErrors.weekdays?.map((m) => <span class="error">{m}</span>)}
              </fieldset>
              <label>
                開始時間
                <input name="startTimes" placeholder="18:00, 20:00" value={batchValues.startTimes ?? ""} required />
                {batchErrors.startTimes?.map((m) => <span class="error">{m}</span>)}
              </label>
              <p>台北時間，以逗號、頓號或空白分隔</p>
              <label>
                時段長度（分鐘）
                <input name="durationMinutes" inputmode="numeric" value={batchValues.durationMinutes ?? ""} required />
                {batchErrors.durationMinutes?.map((m) => <span class="error">{m}</span>)}
              </label>
              <label>
                容量
                <input name="capacity" inputmode="numeric" value={batchValues.capacity ?? ""} required />
                {batchErrors.capacity?.map((m) => <span class="error">{m}</span>)}
              </label>
              <p><button type="submit">預覽</button></p>
            </form>
            {batchPreview && (
              <>
                <h4>將建立 {batchPreview.slots.length} 個時段</h4>
                {batchPreview.slots.length > 0 && <SlotBatchTable slots={batchPreview.slots} />}
                {batchPreview.skipped.length > 0 && (
                  <>
                    <h4>因與既有時段重疊而跳過 {batchPreview.skipped.length} 個</h4>
                    <SlotBatchTable slots={batchPreview.skipped} />
                  </>
                )}
                {batchPreview.slots.length > 0 ? (
                  <form method="post">
                    <input type="hidden" name="intent" value="create-batch" />
                    <input type="hidden" name="fromDate" value={submitted.fromDate ?? ""} />
                    <input type="hidden" name="toDate" value={submitted.toDate ?? ""} />
                    {submittedWeekdays.map((d) => <input type="hidden" name="weekdays" value={d} />)}
                    <input type="hidden" name="startTimes" value={submitted.startTimes ?? ""} />
                    <input type="hidden" name="durationMinutes" value={submitted.durationMinutes ?? ""} />
                    <input type="hidden" name="capacity" value={submitted.capacity ?? ""} />
                    <p><button type="submit">確認建立</button></p>
                  </form>
                ) : (
                  <p>符合條件的時段都與既有時段重疊，沒有可建立的時段；請調整日期、星期或開始時間。</p>
                )}
              </>
            )}
            {batchResult && (
              <>
                <p class="notice" role="status">已建立 {batchResult.slots.length} 個時段</p>
                {batchResult.slots.length > 0 && <SlotBatchTable slots={batchResult.slots} />}
                {batchResult.skipped.length > 0 && (
                  <>
                    <h4>跳過 {batchResult.skipped.length} 個</h4>
                    <p>這些時段與既有時段重疊，可能是預覽後才有人建立了重疊的時段。</p>
                    <SlotBatchTable slots={batchResult.skipped} />
                  </>
                )}
              </>
            )}
          </>
        ) : <p>資源已停用，無法建立新時段。</p>}
      </>
    )
  }
</AdminLayout>
