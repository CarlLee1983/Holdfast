---
// 會員頁：目前有效的保留與未來的訂位；訂位可在這裡取消（與日程表共用表單處理，含原因）
import { env } from "cloudflare:workers";
import { readAccessJwt } from "../../../admin/access-jwt";
import { handleCancelBookingPost } from "../../../admin/cancel-booking";
import { describeFailure, failureStatus } from "../../../admin/reasons";
import { slotCancellable } from "../../../admin/slot-cancellable";
import { formatTaipeiDate, formatTaipeiDateTime, formatTaipeiTime, taipeiDateKey } from "../../../catalog/taipei-time";
import AccessDenied from "../../../components/AccessDenied.astro";
import CancelBookingForm from "../../../components/CancelBookingForm.astro";
import AdminSlotDrawer from "../../../components/AdminSlotDrawer.astro";
import AdminLayout from "../../../layouts/AdminLayout.astro";

export const prerender = false;

const jwt = readAccessJwt(Astro.request, env, import.meta.env.DEV);
const memberId = Astro.params.id ?? "";
const memberHref = `/admin/members/${encodeURIComponent(memberId)}`;
let cancelError = "";
let unauthorized = false;

if (Astro.request.method === "POST") {
  const outcome = await handleCancelBookingPost({
    jwt,
    request: Astro.request,
    app: env.APP,
    successUrl: (id) => `${memberHref}?cancelled=${id}`,
  });
  if ("redirect" in outcome) return Astro.redirect(outcome.redirect, outcome.status);
  if ("json" in outcome) {
    return new Response(JSON.stringify(outcome.json), {
      status: outcome.status,
      headers: { "content-type": "application/json" },
    });
  }
  cancelError = outcome.error;
  unauthorized = outcome.status === 403;
  Astro.response.status = outcome.status;
}

const result = unauthorized ? null : await env.APP.getMemberForAdmin(jwt, { memberId });
unauthorized ||= result !== null && !result.ok && result.reason === "unauthorized";
if (unauthorized) Astro.response.status = 403;
else if (result && !result.ok) Astro.response.status = failureStatus(result.reason);

const detail = result?.ok ? result.data : null;
const loadError = result && !result.ok && !unauthorized ? describeFailure(result).message : null;

if (Astro.request.headers.get("accept")?.includes("application/json")) {
  if (unauthorized) {
    return new Response(JSON.stringify({ ok: false, error: "unauthorized" }), {
      status: 403,
      headers: { "content-type": "application/json" },
    });
  }
  if (result && !result.ok) {
    return new Response(JSON.stringify({ ok: false, error: loadError }), {
      status: failureStatus(result.reason),
      headers: { "content-type": "application/json" },
    });
  }
  return new Response(JSON.stringify({ ok: true, data: detail }), {
    status: 200,
    headers: { "content-type": "application/json" },
  });
}

const now = Date.now();
const cancelled = Astro.url.searchParams.has("cancelled");
const slotLabel = (r: { startsAt: number; endsAt: number }) =>
  `${formatTaipeiDate(r.startsAt)} ${formatTaipeiTime(r.startsAt)}–${formatTaipeiTime(r.endsAt)}`;
---

<AdminLayout title={detail ? detail.member.name : "會員"}>
  {
    unauthorized ? (
      <AccessDenied />
    ) : !detail ? (
      <>
        <p class="error" role="alert">{loadError}</p>
        <p><a href="/admin/members">回到查會員</a></p>
      </>
    ) : (
      <>
        <p><a href="/admin/members">回到查會員</a></p>
        <p class="meta">{detail.member.email}</p>
        {cancelled && <p class="notice" role="status">訂位已取消，名額已歸還。</p>}
        {cancelError && <p class="error" role="alert">{cancelError}</p>}
        {detail.holds.length + detail.bookings.length === 0 && <p>這位會員目前沒有有效的保留或未來的訂位。</p>}
        {detail.bookings.length > 0 && (
          <>
            <h2>訂位</h2>
            <ul class="member-reservations">
              {detail.bookings.map((b) => (
                <li>
                  <a href={`/admin/slots/${b.slotId}`}>{slotLabel(b)}</a>
                  <a class="tag tag--quiet" href={`/admin?date=${taipeiDateKey(b.startsAt)}`}>前往當日看板</a>
                  <span>{b.resourceName}</span>
                  <span>{b.seats} 位</span>
                  {slotCancellable(b.startsAt, now) && <CancelBookingForm bookingId={b.id} slotId={b.slotId} />}
                </li>
              ))}
            </ul>
          </>
        )}
        {detail.holds.length > 0 && (
          <>
            <h2>保留中</h2>
            <ul class="member-reservations">
              {detail.holds.map((h) => (
                <li>
                  <a href={`/admin/slots/${h.slotId}`}>{slotLabel(h)}</a>
                  <a class="tag tag--quiet" href={`/admin?date=${taipeiDateKey(h.startsAt)}`}>前往當日看板</a>
                  <span>{h.resourceName}</span>
                  <span>{h.seats} 位</span>
                  <span class="tag tag--quiet">保留中</span>
                  <span>到期 {formatTaipeiDateTime(h.expiresAt)}</span>
                </li>
              ))}
            </ul>
          </>
        )}
        <AdminSlotDrawer />
      </>
    )
  }
</AdminLayout>

