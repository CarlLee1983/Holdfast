---
import MemberLayout from "../layouts/MemberLayout.astro";
import { env } from "cloudflare:workers";
import { loginUrl } from "../auth/member";
import { CANCEL_INTENT } from "../holds/cancel";
import { CONFIRM_INTENT } from "../holds/confirm";
import { handleMePost } from "../holds/me-post";
import { heldNotice } from "../holds/held-notice";
import { formatTaipeiDate, formatTaipeiTime } from "../catalog/taipei-time";
import { bookingCancellation } from "../holds/cancellation";
import { holdOrBookingStatus } from "../shared/booking-status";

export const prerender = false;

const member = Astro.locals.member;
if (!member) return Astro.redirect(loginUrl(Astro.url), 303);

let formError = "";
if (Astro.request.method === "POST") {
  const outcome = await handleMePost({ member, request: Astro.request, app: env.APP, url: Astro.url });
  if ("redirect" in outcome) return Astro.redirect(outcome.redirect, outcome.status);
  formError = outcome.error;
  Astro.response.status = outcome.status;
}

// RPC 回報失敗時直接丟出，不把故障顯示成「沒有保留」
const result = await env.APP.listMyHolds(member.memberId);
if (!result.ok) throw new Error(`listMyHolds 失敗：${result.reason}`);
const holds = result.data;

const bookingsResult = await env.APP.listMyBookings(member.memberId);
if (!bookingsResult.ok) throw new Error(`listMyBookings 失敗：${bookingsResult.reason}`);
const bookings = bookingsResult.data;

const confirmedId = Astro.url.searchParams.get("confirmed");
// 已取消的訂位不在列表裡，無法像 confirmed 那樣對照列表驗證，所以只檢查格式；訊息本身不含任何資料
const cancelledId = Astro.url.searchParams.get("cancelled");
const now = Date.now();

const notice = heldNotice(holds, Astro.url.searchParams.get("held"));

// 訂位狀態對應的標籤樣式；領域 status 不直接當 CSS class
const BADGE_VARIANT = { confirmed: "badge--solid", cancelled: "badge--muted" } as const;

const formatDateTime = (epochMs: number) => `${formatTaipeiDate(epochMs)} ${formatTaipeiTime(epochMs)}`;
---

<MemberLayout title="我的保留與訂位">
  <h1>我的保留與訂位</h1>
  <p><a href="/">回到時段列表</a>　時間皆為台北時間。</p>
  {formError && <p role="alert">{formError}</p>}
  {confirmedId !== null && bookings.some((b) => String(b.id) === confirmedId && b.status === "confirmed") && <p role="status">訂位成功</p>}
  {cancelledId !== null && /^\d+$/.test(cancelledId) && <p role="status">已取消訂位</p>}
  {notice?.kind === "held" && <p role="status">保留成功，請於 {formatDateTime(notice.hold.expiresAt)} 前確認</p>}
  {notice?.kind === "missing" && <p role="status">此保留已過期或不存在</p>}
  <section aria-labelledby="holds-heading">
    <h2 id="holds-heading">我的保留</h2>
    {
      holds.length === 0 ? (
        <p>目前沒有有效的保留</p>
      ) : (
        <ul class="card-list">
          {holds.map((hold) => (
            <li>
              <article class="card" aria-labelledby={`hold-${hold.id}-title hold-${hold.id}-date hold-${hold.id}-time`}>
                <h3 id={`hold-${hold.id}-title`}>{hold.resourceName}</h3>
                <p class="card-when">
                  <span id={`hold-${hold.id}-date`}>{formatTaipeiDate(hold.startsAt)}</span>
                  <span id={`hold-${hold.id}-time`}>
                    {formatTaipeiTime(hold.startsAt)}–{formatTaipeiTime(hold.endsAt)}
                  </span>
                </p>
                <p class="card-meta">名額 {hold.seats}</p>
                <p class="card-meta hold-expiry">
                  請於 <time datetime={new Date(hold.expiresAt).toISOString()}>{formatDateTime(hold.expiresAt)}</time> 前確認
                </p>
                <form method="post">
                  <input type="hidden" name="intent" value={CONFIRM_INTENT} />
                  <input type="hidden" name="holdId" value={hold.id} />
                  <button type="submit">確認訂位</button>
                </form>
              </article>
            </li>
          ))}
        </ul>
      )
    }
  </section>
  <section aria-labelledby="bookings-heading">
    <h2 id="bookings-heading">我的訂位</h2>
    {
      bookings.length === 0 ? (
        <p>目前沒有訂位</p>
      ) : (
        <ul class="card-list">
          {bookings.map((booking) => {
            const cancellation = bookingCancellation(booking, now);
            return (
              <li>
                <article
                  class:list={["card", { cancelled: booking.status === "cancelled" }]}
                  aria-labelledby={`booking-${booking.id}-title booking-${booking.id}-date booking-${booking.id}-time`}
                >
                  <header class="card-head">
                    <h3 id={`booking-${booking.id}-title`}>{booking.resourceName}</h3>
                    <span class:list={["badge", BADGE_VARIANT[booking.status]]}>{holdOrBookingStatus(booking)}</span>
                  </header>
                  <p class="card-when">
                    <span id={`booking-${booking.id}-date`}>{formatTaipeiDate(booking.startsAt)}</span>
                    <span id={`booking-${booking.id}-time`}>
                      {formatTaipeiTime(booking.startsAt)}–{formatTaipeiTime(booking.endsAt)}
                    </span>
                  </p>
                  <p class="card-meta">名額 {booking.seats}</p>
                  <p class="card-meta">取消截止時間 {formatDateTime(booking.cancellableUntil)}</p>
                  {cancellation === "cancellable" && (
                    <form method="post">
                      <input type="hidden" name="intent" value={CANCEL_INTENT} />
                      <input type="hidden" name="bookingId" value={booking.id} />
                      <button type="submit" class="secondary">取消訂位</button>
                    </form>
                  )}
                  {cancellation === "past-cutoff" && <p class="card-meta">已過取消截止時間</p>}
                </article>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
  <section aria-labelledby="account-heading">
    <h2 id="account-heading">帳號</h2>
    <p><a href="/account/delete">刪除我的帳號</a></p>
  </section>
</MemberLayout>

<style>
  .card-when {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    margin: var(--space-2) 0 0;
    font-size: var(--text-lg);
    font-variant-numeric: tabular-nums;
  }
  .card-meta {
    margin: var(--space-1) 0 0;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
  }
  .card form {
    margin-top: var(--space-3);
  }
  /* 已取消（含管理者取消）：整張卡片降低對比、標籤改虛線框，與已確認的實心標籤分辨 */
  .card.cancelled {
    background: var(--muted);
    box-shadow: none;
  }
  .card.cancelled h3,
  .card.cancelled .card-when {
    color: var(--muted-foreground);
  }
  .card.cancelled .badge {
    border-style: dashed;
  }
</style>
