---
import { env } from "cloudflare:workers";
import { loginUrl } from "../auth/member";
import { heldNotice } from "../holds/held-notice";
import { formatTaipeiDate, formatTaipeiTime } from "../catalog/taipei-time";

export const prerender = false;

const member = Astro.locals.member;
if (!member) return Astro.redirect(loginUrl(Astro.url), 303);

// RPC 回報失敗時直接丟出，不把故障顯示成「沒有保留」
const result = await env.APP.listMyHolds(member.memberId);
if (!result.ok) throw new Error(`listMyHolds 失敗：${result.reason}`);
const holds = result.data;

const notice = heldNotice(holds, Astro.url.searchParams.get("held"));

const formatDateTime = (epochMs: number) => `${formatTaipeiDate(epochMs)} ${formatTaipeiTime(epochMs)}`;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>我的保留 | Holdfast 訂位</title>
  </head>
  <body>
    <h1>我的保留</h1>
    <p><a href="/">回到時段列表</a>　時間皆為台北時間。</p>
    {notice?.kind === "held" && <p role="status">保留成功，請於 {formatDateTime(notice.hold.expiresAt)} 前確認</p>}
    {notice?.kind === "missing" && <p role="status">此保留已過期或不存在</p>}
    {
      holds.length === 0 ? (
        <p>目前沒有有效的保留</p>
      ) : (
        <table>
          <thead>
            <tr>
              <th>資源</th>
              <th>日期</th>
              <th>時間</th>
              <th>名額</th>
              <th>到期時間</th>
            </tr>
          </thead>
          <tbody>
            {holds.map((hold) => (
              <tr>
                <td>{hold.resourceName}</td>
                <td>{formatTaipeiDate(hold.startsAt)}</td>
                <td>
                  {formatTaipeiTime(hold.startsAt)}–{formatTaipeiTime(hold.endsAt)}
                </td>
                <td>{hold.seats}</td>
                <td>{formatDateTime(hold.expiresAt)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </body>
</html>
