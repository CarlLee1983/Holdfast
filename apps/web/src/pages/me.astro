---
import MemberLayout from "../layouts/MemberLayout.astro";
import { env } from "cloudflare:workers";
import { loginUrl } from "../auth/member";
import { CANCEL_INTENT } from "../holds/cancel";
import { handleMePost } from "../holds/me-post";
import { formatTaipeiDate, formatTaipeiDateTime, formatTaipeiTime } from "../catalog/taipei-time";
import { bookingCancellation } from "../holds/cancellation";
import { parseRecordId } from "../holds/record-id";
import { holdOrBookingStatus } from "../shared/booking-status";

export const prerender = false;

const member = Astro.locals.member;
if (!member) return Astro.redirect(loginUrl(Astro.url), 303);

let formError = "";
if (Astro.request.method === "POST") {
  const outcome = await handleMePost({ member, request: Astro.request, app: env.APP, url: Astro.url });
  if ("redirect" in outcome) return Astro.redirect(outcome.redirect, outcome.status);
  formError = outcome.error;
  Astro.response.status = outcome.status;
}

// RPC 回報失敗時直接丟出，不把故障顯示成「沒有保留」
const result = await env.APP.listMyHolds(member.memberId);
if (!result.ok) throw new Error(`listMyHolds 失敗：${result.reason}`);
const holds = result.data;

const bookingsResult = await env.APP.listMyBookings(member.memberId);
if (!bookingsResult.ok) throw new Error(`listMyBookings 失敗：${bookingsResult.reason}`);
const bookings = bookingsResult.data;

// 只檢查格式，不對照列表；訊息本身不含任何資料
const cancelledId = parseRecordId(Astro.url.searchParams.get("cancelled") ?? undefined);
const now = Date.now();

// 訂位狀態對應的標籤樣式；領域 status 不直接當 CSS class
const TAG_VARIANT = { confirmed: "tag--solid", cancelled: "tag--quiet" } as const;

---

<MemberLayout title="我的保留與訂位">
  <h1>我的保留與訂位</h1>
  <p class="meta"><a href="/">回到時段列表</a>　時間皆為台北時間。</p>
  {formError && <p role="alert">{formError}</p>}
  {cancelledId !== null && <p role="status">已取消訂位</p>}
  <section class="list-section" aria-labelledby="holds-heading">
    <h2 id="holds-heading" class="eyebrow">我的保留</h2>
    {
      holds.length === 0 ? (
        <p class="empty">目前沒有有效的保留</p>
      ) : (
        <>
          <div id="hold-announcer" class="visually-hidden" aria-live="polite"></div>
          <ul class="rule-list">
            {holds.map((hold) => (
              <li>
                <article
                  class="rule-item"
                  data-remaining-ms={hold.expiresAt - now}
                  data-label={`${hold.resourceName} ${formatTaipeiDate(hold.startsAt)} ${formatTaipeiTime(hold.startsAt)}`}
                  aria-labelledby={`hold-${hold.id}-title hold-${hold.id}-date hold-${hold.id}-time`}
                >
                  <h3 class="rule-title" id={`hold-${hold.id}-title`}>{hold.resourceName}</h3>
                  <p class="when numeric">
                    <span id={`hold-${hold.id}-date`}>{formatTaipeiDate(hold.startsAt)}</span>
                    <span id={`hold-${hold.id}-time`}>
                      {formatTaipeiTime(hold.startsAt)}–{formatTaipeiTime(hold.endsAt)}
                    </span>
                  </p>
                  <p class="meta">{hold.seats} 位</p>
                  <p class="meta hold-expiry">
                    請於 <time datetime={new Date(hold.expiresAt).toISOString()}>{formatTaipeiDateTime(hold.expiresAt)}</time> 前確認
                  </p>
                  {/* 預設隱藏，由用戶端 script 顯示；沒有 JS 時只剩上面的絕對到期時間 */}
                  <p class="meta hold-countdown" hidden>
                    剩餘 <span class="countdown-text" aria-live="off"></span>
                  </p>
                  <a class="continue" data-continue href={`/holds/${hold.id}`}>繼續確認</a>
                </article>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
  <section class="list-section" aria-labelledby="bookings-heading">
    <h2 id="bookings-heading" class="eyebrow">我的訂位</h2>
    {
      bookings.length === 0 ? (
        <p class="empty">目前沒有訂位</p>
      ) : (
        <ul class="rule-list">
          {bookings.map((booking) => {
            const cancellation = bookingCancellation(booking, now);
            return (
              <li>
                <article
                  class:list={["rule-item", { cancelled: booking.status === "cancelled" }]}
                  aria-labelledby={`booking-${booking.id}-title booking-${booking.id}-date booking-${booking.id}-time`}
                >
                  <header class="rule-head">
                    <h3 class="rule-title" id={`booking-${booking.id}-title`}>{booking.resourceName}</h3>
                    <span class:list={["tag", TAG_VARIANT[booking.status]]}>{holdOrBookingStatus(booking)}</span>
                  </header>
                  <p class="when numeric">
                    <span id={`booking-${booking.id}-date`}>{formatTaipeiDate(booking.startsAt)}</span>
                    <span id={`booking-${booking.id}-time`}>
                      {formatTaipeiTime(booking.startsAt)}–{formatTaipeiTime(booking.endsAt)}
                    </span>
                  </p>
                  <p class="meta">{booking.seats} 位</p>
                  {booking.status === "cancelled" && booking.cancellationReason && (
                    <p class="meta">取消原因：{booking.cancellationReason}</p>
                  )}
                  <p class="meta">取消截止時間 {formatTaipeiDateTime(booking.cancellableUntil)}</p>
                  {cancellation === "cancellable" && (
                    <form method="post">
                      <input type="hidden" name="intent" value={CANCEL_INTENT} />
                      <input type="hidden" name="bookingId" value={booking.id} />
                      <button type="submit" class="secondary">取消訂位</button>
                    </form>
                  )}
                  {cancellation === "past-cutoff" && <p class="meta">已過取消截止時間</p>}
                </article>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>
  <section class="list-section" aria-labelledby="account-heading">
    <h2 id="account-heading" class="eyebrow">帳號</h2>
    <p><a href="/account/delete">刪除我的帳號</a></p>
  </section>
</MemberLayout>

<script>
  import { startHoldCountdowns } from "../holds/countdown-client";

  startHoldCountdowns();
</script>

<style>
  .when {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-sm);
    font-size: var(--text-md);
    font-weight: 500;
  }
  .rule-item form,
  .continue {
    margin-top: var(--space-xs);
  }
  .continue {
    justify-self: start;
    font-size: var(--text-sm);
    font-weight: 500;
  }
  /* 已取消（含管理者取消）：整列降低對比、時間加刪除線，標籤改虛線框，與已確認的實心標籤分辨 */
  .rule-item.cancelled h3,
  .rule-item.cancelled .when {
    color: var(--color-muted);
  }
  .rule-item.cancelled .when {
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
</style>
