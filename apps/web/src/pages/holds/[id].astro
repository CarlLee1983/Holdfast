---
import BookingDetails from "../../components/BookingDetails.astro";
import MemberLayout from "../../layouts/MemberLayout.astro";
import { env } from "cloudflare:workers";
import { loginUrl } from "../../auth/member";
import { formatTaipeiDateTime } from "../../catalog/taipei-time";
import { cancellationRuleText } from "../../holds/cancellation";
import { handleConfirmPost } from "../../holds/confirm";
import { bookingPagePath, bookingPageState } from "../../holds/booking-page";
import { holdPageState, reselectUrl } from "../../holds/hold-page";
import { holdTtlRuleText } from "../../holds/rule-text";
import { MERCHANT } from "../../merchant/merchant";

export const prerender = false;

const member = Astro.locals.member;
if (!member) return Astro.redirect(loginUrl(Astro.url), 303);

let formError = "";
let errorStatus: number | null = null;
if (Astro.request.method === "POST") {
  const outcome = await handleConfirmPost({ member, holdId: Astro.params.id, app: env.APP, url: Astro.url });
  if ("redirect" in outcome) return Astro.redirect(outcome.redirect, outcome.status);
  formError = outcome.error;
  errorStatus = outcome.status;
}

// RPC 回報失敗時直接丟出，不把故障顯示成「保留不存在」
const result = await env.APP.listMyHolds(member.memberId);
if (!result.ok) throw new Error(`listMyHolds 失敗：${result.reason}`);
const state = holdPageState(result.data, Astro.params.id);
// 保留與訂位是同一筆資料、同一個 id：不是有效保留、卻是自己的訂位（已確認，或重複送出後重新渲染），就導到完成頁。
// 只有在這個情況才多查一次 listMyBookings
if (state.kind === "unavailable") {
  const bookingsResult = await env.APP.listMyBookings(member.memberId);
  if (!bookingsResult.ok) throw new Error(`listMyBookings 失敗：${bookingsResult.reason}`);
  const booking = bookingPageState(bookingsResult.data, Astro.params.id);
  if (booking.kind === "found") return Astro.redirect(bookingPagePath(booking.booking.id), 303);
}
// 確認失敗且保留仍有效時沿用失敗的狀態碼；unavailable 一律 404（重新渲染時保留可能剛好過期，同樣是 unavailable）
if (state.kind === "unavailable") Astro.response.status = 404;
else if (errorStatus !== null) Astro.response.status = errorStatus;

const now = Date.now();
---

<MemberLayout title={state.kind === "active" ? "確認訂位" : "保留已過期或不存在"} noindex>
  {
    state.kind === "unavailable" ? (
      <section class="unavailable" aria-labelledby="unavailable-title">
        <h1 id="unavailable-title">此保留已過期或不存在</h1>
        {formError && <p role="alert">{formError}</p>}
        <p class="meta">
          <a href="/">重新選擇時段</a>
        </p>
      </section>
    ) : (
      <div
        class="hold-page"
        data-remaining-ms={state.hold.expiresAt - now}
        data-label={`${state.hold.resourceName} ${formatTaipeiDateTime(state.hold.startsAt)}`}
      >
        <header class="head">
          <h1>確認訂位</h1>
          {formError && <p role="alert">{formError}</p>}
          <p class="expiry">
            請於 <time datetime={new Date(state.hold.expiresAt).toISOString()}>{formatTaipeiDateTime(state.hold.expiresAt)}</time> 前確認
          </p>
          {/* 預設隱藏，由用戶端 script 顯示；沒有 JS 時只剩上面的絕對到期時間 */}
          <p class="meta hold-countdown" hidden>
            剩餘 <span class="countdown-text numeric" aria-live="off"></span>
          </p>
          <div id="hold-announcer" class="visually-hidden" aria-live="polite"></div>
        </header>

        <BookingDetails
          startsAt={state.hold.startsAt}
          endsAt={state.hold.endsAt}
          seats={state.hold.seats}
          resourceName={state.hold.resourceName}
          description={state.hold.resourceDescription}
        />

        <p class="as-member">以{member.name}的身分訂位</p>

        <section class="list-section" aria-labelledby="notes-heading">
          <h2 id="notes-heading">訂位須知</h2>
          <ul class="rule-list">
            <li class="rule-item">{holdTtlRuleText(state.hold.holdTtlSeconds)}</li>
            <li class="rule-item">{cancellationRuleText(state.hold.cancellationCutoffSeconds)}</li>
            <li class="rule-item">超過取消時限請來電 {MERCHANT.phone}</li>
          </ul>
        </section>

        <div class="actions">
          <form method="post">
            <button type="submit" class="primary-action" data-confirm>確認訂位</button>
          </form>
          <a class="reselect" href={reselectUrl(state.hold)}>重新選擇時段</a>
        </div>
      </div>
    )
  }
</MemberLayout>

<script>
  import { startHoldCountdowns } from "../../holds/countdown-client";

  startHoldCountdowns();
</script>

<style>
  .unavailable,
  .hold-page {
    display: grid;
    gap: var(--space-lg);
  }
  .head {
    display: grid;
    gap: var(--space-xs);
  }
  .expiry {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .countdown-text {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--color-ink);
  }

  .as-member {
    font-size: var(--text-sm);
  }
  .list-section {
    margin-top: 0;
  }
  .rule-item {
    font-size: var(--text-sm);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
  }
  .reselect {
    font-size: var(--text-sm);
  }
</style>
