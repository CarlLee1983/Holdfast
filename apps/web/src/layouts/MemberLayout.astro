---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/cards.css";
import { loginUrl } from "../auth/member";

interface Props {
  /** 頁名；標題組成「<頁名> | Holdfast 訂位」 */
  title: string;
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
const member = Astro.locals.member;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title} | Holdfast 訂位</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="container site-nav" aria-label="主要導覽">
        <a class="brand" href="/">Holdfast</a>
        <div class="account">
          {
            member ? (
              <>
                <span class="member-name">{member.name}</span>
                <a href="/me">我的保留與訂位</a>
                <button type="button" class="secondary" id="sign-out">
                  登出
                </button>
              </>
            ) : Astro.url.pathname === "/login" ? null : (
              <a href={loginUrl(Astro.url)}>登入</a>
            )
          }
        </div>
      </nav>
      <p id="sign-out-error" class="container" role="alert" hidden></p>
    </header>
    <main class="container page">
      <slot />
    </main>
    <script>
      import { requestSignOut } from "../auth/client";

      // 登出：Better Auth 的 sign-out 是 POST（需帶 Origin 與 cookie），回應會清掉 session cookie
      const signOut = document.querySelector<HTMLButtonElement>("#sign-out");
      signOut?.addEventListener("click", async () => {
        // 請求進行中停用按鈕，避免連點重複送出；失敗才恢復
        signOut.disabled = true;
        if (await requestSignOut(fetch)) {
          location.reload();
          return;
        }
        signOut.disabled = false;
        const error = document.querySelector<HTMLElement>("#sign-out-error")!;
        error.textContent = "登出失敗，請稍後再試。";
        error.hidden = false;
      });

      // 防重複送出（漸進增強）：以事件委派涵蓋所有 method="post" 的表單（保留、確認、取消、刪除帳號），
      // 送出後停用送出按鈕。沒有 JS 時表單照常送出，伺服器端與表單欄位都不受影響。
      // 停用放在 submit 事件而非 click：原生驗證失敗（例如名額超出 max）時不會觸發 submit，按鈕因此維持可按；
      // 在 submit 事件中停用按鈕也不會取消這次送出（送出的按鈕本身沒有 name／value，不影響表單資料）。
      const SUBMITTING = "submitting";
      document.addEventListener("submit", (event) => {
        // 已被其他處理器 preventDefault 就不會送出，不該停用按鈕
        if (event.defaultPrevented) return;
        const form = event.target;
        if (!(form instanceof HTMLFormElement) || form.method !== "post") return;
        const button = event.submitter ?? form.querySelector("button[type=submit], input[type=submit]");
        if (!(button instanceof HTMLButtonElement || button instanceof HTMLInputElement) || button.disabled) return;
        button.disabled = true;
        button.dataset[SUBMITTING] = "";
      });

      // 從 bfcache 返回時頁面不會重新載入，被停用的按鈕會一直停用。
      // 只恢復帶 data-submitting 標記的按鈕：/me 的倒數到期後由另一段 script 停用的「確認訂位」沒有這個標記，維持停用。
      // 例外約定：帶 data-expired（倒數到期時由 me.astro 設定）的按鈕即使也有 data-submitting，仍不恢復可按，只移除送出標記
      window.addEventListener("pageshow", (event) => {
        if (!event.persisted) return;
        for (const button of document.querySelectorAll<HTMLButtonElement | HTMLInputElement>("[data-submitting]")) {
          delete button.dataset[SUBMITTING];
          if (!button.hasAttribute("data-expired")) button.disabled = false;
        }
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    padding-block: var(--space-3);
  }
  .site-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-4);
  }
  .brand {
    color: var(--foreground);
    font-weight: 700;
    font-size: var(--text-lg);
    text-decoration: none;
  }
  .account {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
  }
  .member-name {
    color: var(--muted-foreground);
  }
  #sign-out-error {
    margin-top: var(--space-2);
  }
  .page {
    padding-block: var(--space-4);
  }
  @media (min-width: 40rem) {
    .page {
      padding-block: var(--space-6);
    }
  }
</style>
