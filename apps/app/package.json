{
  "name": "@holdfast/app",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/entrypoint.ts"
  },
  "scripts": {
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply holdfast --local --persist-to ../../.wrangler/state",
    "db:seed:local": "wrangler d1 execute holdfast --local --persist-to ../../.wrangler/state --file=seed/seed.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6",
    "vitest": "^4.1.0",
    "wrangler": "^4.143.0"
  }
}
