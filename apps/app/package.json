{
  "name": "@holdfast/app",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/entrypoint.ts"
  },
  "scripts": {
    "typecheck": "wrangler types --strict-vars=false && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "admin:dev-token": "bun scripts/admin-dev-token.ts",
    "auth:generate": "bunx auth@1.7.6 generate --config auth.cli.ts --output src/auth/schema.ts --yes",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply holdfast --local --persist-to ../../.wrangler/state",
    "db:seed:local": "wrangler d1 execute holdfast --local --persist-to ../../.wrangler/state --file=seed/seed.sql",
    "db:migrate:preview": "wrangler d1 migrations apply DB --env preview --remote",
    "deploy:preview": "wrangler deploy --env preview",
    "db:migrate:production": "wrangler d1 migrations apply DB --env production --remote",
    "deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@types/node": "^26.6.3",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6",
    "vitest": "^4.1.0",
    "wrangler": "^4.143.0"
  }
}
